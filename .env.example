# --- Telegram API credentials (https://my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Bot credentials (from @BotFather) ---
BOT_TOKEN=
BOT_USERNAME=

# --- Qdrant Cloud (tg_bot_rag cluster database) ---
QDRANT_URL=
QDRANT_API_KEY=

# --- DeepSeek LLM ---
DEEPSEEK_API_KEY=

# --- Admin RBAC (generate: openssl rand -hex 32) ---
# Used to compute challenge responses: python rbac.py respond <nonce>
ADMIN_SECRET=

# --- Control API bearer token (generate: openssl rand -hex 24) ---
# Leave empty to disable the control endpoints entirely.
API_TOKEN=

# --- Optional overrides (defaults shown) ---
# SESSION_USERBOT=my_userbot
# SESSION_BOT=inline_bot
# SCRAPER_WORKERS=4
# SCRAPER_PAGE_SIZE=100
# TG_OPS_PER_SECOND=5
# TG_OPS_BURST=5
# FLOOD_WAIT_MARGIN=1.15
# MAX_VECTORS=100000
# STORAGE_WARN_RATIO=0.80
# STORAGE_PAUSE_RATIO=0.95
# OCR_LANGUAGES=eng+rus
# API_HOST=127.0.0.1
# API_PORT=8088
# ADMIN_SESSION_TTL_SECONDS=2700
#
# --- Phase 2 (defaults shown; see config.py for the full list) ---
# LOG_LEVEL=INFO
# LOG_JSON=true
# LOG_DIR=logs
# FAILOVER_ENABLED=true
# FAILOVER_DEGRADE_ERRORS=3
# FAILOVER_HEALTH_INTERVAL_SECONDS=30
# FAILOVER_RESYNC_BATCH=200
# DISCOVERY_ENABLED=true
# DISCOVERY_INTERVAL_SECONDS=1800
# DISCOVERY_AUTO_JOIN=true
# DISCOVERY_MUTE_JOINED=true
# DISCOVERY_AUTO_LEAVE_BAD=false
# DISCOVERY_MAX_JOINS_PER_CYCLE=3
# DISCOVERY_SEEDS_FILE=seeds.yaml
# WEB_DISCOVERY_ENABLED=false
# WATCHLIST_FLUSH_SECONDS=60
# CONTROL_FLAG_POLL_SECONDS=5
# QUERY_MAX_RESULTS=100
