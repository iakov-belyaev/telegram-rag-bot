# Seed groups/channels for the discovery agent (copy to seeds.yaml, which is gitignored).
# Every entry is validated + quality-gated before any join happens.
groups:
  - "@example_cyprus_it"
  - "@example_cyprus_jobs"
  - "https://t.me/+ExampleInviteHash"

# Adapters to run (subset of: seeds, cyprus_it, kiprinfobot, web)
enabled_adapters:
  - seeds
  - cyprus_it
  - kiprinfobot
